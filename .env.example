# Database (Neon / Supabase Postgres)
# Use the non-pooled/direct connection string if your provider distinguishes
# them (drizzle-kit push works best against a direct connection).
DATABASE_URL=

# Admin panel (/admin/availability) — pick any strong password.
# This is the only credential needed to sign in; there are no user accounts.
ADMIN_PASSWORD=

# Stripe (test mode keys while developing — find them at
# https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook's signing secret in the
# Stripe Dashboard once a production endpoint is configured.
STRIPE_WEBHOOK_SECRET=
# Not currently used by the app (Checkout redirects to a Stripe-hosted
# page, so no Stripe.js on the client) — safe to leave unset.
# STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email — admin notification + customer confirmation
# on each paid booking). Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where the admin ("New booking paid") notification email is sent.
ADMIN_EMAIL=
# Must be an address on a domain you've verified in Resend, e.g.
# "Carray Tutoring <bookings@carraytutoring.de>". While testing without a
# verified domain, Resend lets you send from "onboarding@resend.dev" —
# but only to your own Resend account email in that case.
EMAIL_FROM=

# Papierkram — wired up in a later module
# PAPIERKRAM_API_TOKEN=
